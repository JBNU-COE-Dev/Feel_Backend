# Google Cloud Platform Production Environment Variables
# 배포 시 실제 값으로 변경하세요

# Database Configuration
DB_USERNAME=feel
DB_PASSWORD=CHANGE_THIS_TO_SECURE_PASSWORD

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Google Cloud SQL (선택사항 - Cloud SQL 사용 시)
# CLOUD_SQL_INSTANCE_CONNECTION_NAME=project-id:region:instance-name
# CLOUD_SQL_DATABASE_NAME=feeldb

# Security (선택사항)
# JWT_SECRET=your_jwt_secret_key_here
# ADMIN_PASSWORD=your_admin_password_here
